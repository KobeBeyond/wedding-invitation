/* app.wxss — 全局样式 */

page {
  --color-primary: #e8a0a0;
  --color-secondary: #d4af37;
  --color-bg: #fdf5f6;
  --color-text: #4a4a4a;
  --color-accent: #ff6b81;
  --color-card: #ffffff;
  --color-border: #f0e0e0;
  --color-muted: #999999;

  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx;
}

/* 卡片 */
.card {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(232, 160, 160, 0.12);
  margin-bottom: 24rpx;
}

/* 标题 */
.title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--color-text);
  text-align: center;
}

.subtitle {
  font-size: 30rpx;
  color: var(--color-primary);
  text-align: center;
  margin-top: 12rpx;
}

/* 按钮 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx 80rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 48rpx;
  padding: 22rpx 78rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.btn-outline::after {
  border: none;
}

/* 动画 */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(232,160,160,0.4); }
  50%      { transform: scale(1.03); box-shadow: 0 0 0 20rpx rgba(232,160,160,0); }
}

.fade-in-up {
  animation: fadeInUp 0.8s ease forwards;
}

.fade-in {
  animation: fadeIn 1s ease forwards;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx 0;
}

/* 文本工具类 */
.text-center { text-align: center; }
.text-muted  { color: var(--color-muted); }
.text-primary { color: var(--color-primary); }
.text-gold   { color: var(--color-secondary); }
