/* pages/venue/venue.wxss */

.venue-page {
  padding: 30rpx;
  padding-bottom: env-safe-area-inset-bottom;
}

/* 标题 */
.page-title {
  text-align: center;
  margin-bottom: 30rpx;
}

.title-main {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--color-text);
}

.title-deco {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.deco-line {
  width: 100rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
}

.deco-heart {
  font-size: 28rpx;
}

/* 酒店信息卡片 */
.venue-card {
  text-align: center;
}

.venue-name {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--color-text);
}

.venue-hall {
  font-size: 30rpx;
  color: var(--color-primary);
  margin-top: 12rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.info-label {
  font-size: 28rpx;
  color: var(--color-muted);
  flex-shrink: 0;
  min-width: 80rpx;
}

.info-value {
  font-size: 28rpx;
  color: var(--color-text);
  flex: 1;
}

/* 地图 */
.map-section {
  margin-bottom: 30rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(232,160,160,0.15);
}

.venue-map {
  width: 100%;
  height: 400rpx;
}

/* 导航按钮 */
.nav-btn-wrap {
  margin-bottom: 30rpx;
}

.nav-btn {
  width: 100%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
}

/* 交通指引 */
.transport-card {
  padding: 36rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.transport-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 16rpx 0;
}

.transport-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.transport-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.transport-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.transport-text {
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.5;
}
