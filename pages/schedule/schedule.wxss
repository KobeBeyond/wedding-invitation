/* pages/schedule/schedule.wxss */

.schedule-page {
  padding: 30rpx;
  padding-bottom: env-safe-area-inset-bottom;
}

/* 标题 */
.page-title {
  text-align: center;
  margin-bottom: 50rpx;
}

.title-main {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--color-text);
}

.title-deco {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 16rpx;
  margin-bottom: 12rpx;
}

.deco-line {
  width: 100rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
}

.deco-heart {
  font-size: 28rpx;
}

.title-sub {
  font-size: 26rpx;
  color: var(--color-muted);
}

/* 时间线 */
.timeline {
  padding: 0 20rpx;
}

.timeline-item {
  display: flex;
  gap: 24rpx;
  min-height: 180rpx;
}

/* 左侧时间列 */
.time-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  flex-shrink: 0;
}

.time-badge {
  width: 120rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--color-primary), #f0b0b0);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(232,160,160,0.3);
}

.time-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.time-line {
  flex: 1;
  width: 4rpx;
  background: linear-gradient(180deg, var(--color-primary), rgba(232,160,160,0.1));
  margin-top: 8rpx;
  min-height: 60rpx;
}

/* 右侧内容 */
.content-col {
  flex: 1;
  padding-bottom: 30rpx;
}

.content-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(232,160,160,0.1);
  border-left: 6rpx solid var(--color-primary);
}

.content-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.content-icon {
  font-size: 36rpx;
}

.content-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-text);
}

.content-desc {
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

/* 底部寄语 */
.ending {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 30rpx;
  padding: 40rpx 0;
}

.ending-line {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
}

.ending-text {
  font-size: 30rpx;
  color: var(--color-primary);
  letter-spacing: 4rpx;
}
