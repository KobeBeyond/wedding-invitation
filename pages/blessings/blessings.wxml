<!-- pages/blessings/blessings.wxml -->
<view class="blessings-page">

  <!-- 弹幕区域 -->
  <view class="danmaku-area">
    <danmaku id="danmaku"></danmaku>

    <!-- 计数 -->
    <view class="count-badge" wx:if="{{blessingCount > 0}}">
      <text>已收到 {{blessingCount}} 条祝福</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{blessingCount === 0 && !loading}}">
      <text class="empty-icon">💌</text>
      <text class="empty-text">还没有祝福，快来写下第一条吧</text>
    </view>

    <!-- 加载中 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text class="loading-text">加载祝福中...</text>
    </view>
  </view>

  <!-- 输入栏 -->
  <view class="input-bar">
    <input class="blessing-input" placeholder="写下你的祝福..." value="{{inputText}}"
           bindinput="onInput" confirm-type="send" bindconfirm="sendBlessing"
           maxlength="50" />
    <view class="send-btn {{inputText.trim() ? 'active' : ''}}" bindtap="sendBlessing">
      <text>发送</text>
    </view>
  </view>

</view>
