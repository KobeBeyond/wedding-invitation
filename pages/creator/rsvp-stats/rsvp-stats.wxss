/* pages/creator/rsvp-stats/rsvp-stats.wxss */
.rsvp-stats {
  background: #fdf5f6;
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 统计概览 */
.stats-overview {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  min-width: 120rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(232, 160, 160, 0.08);
}

.stat-card.highlight {
  background: linear-gradient(135deg, #fce8ec, #f5d5d5);
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #4a4a4a;
  margin-bottom: 8rpx;
}

.stat-card.highlight .stat-num {
  color: #d45d5d;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #888;
}

/* 筛选标签 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-tag {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666;
  background: #fff;
  border: 2rpx solid #f0e0e0;
}

.filter-tag.active {
  background: #e8a0a0;
  color: #fff;
  border-color: #e8a0a0;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0e0e0;
  border-top-color: #e8a0a0;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #aaa;
}

/* 来宾列表 */
.guest-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.guest-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(232, 160, 160, 0.06);
}

.guest-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.guest-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #4a4a4a;
}

.guest-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.guest-status.yes {
  background: #e8f5e9;
  color: #4caf50;
}

.guest-status.no {
  background: #ffebee;
  color: #f44336;
}

.guest-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-item {
  font-size: 26rpx;
  color: #888;
  word-break: break-all;
}
