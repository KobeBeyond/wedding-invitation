/* pages/creator/template/template.wxss */
.template-page {
  min-height: 100vh;
  background: #fafafa;
  padding: 32rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #4a4a4a;
  margin-bottom: 8rpx;
}

.page-desc {
  font-size: 26rpx;
  color: #aaa;
  margin-bottom: 40rpx;
}

.template-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.template-item {
  position: relative;
  display: flex;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 4rpx solid transparent;
  transition: border-color 0.2s;
}

.template-item.selected {
  border-color: #e8a0a0;
}

.template-preview {
  flex-shrink: 0;
  width: 260rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.preview-names {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.preview-date {
  font-size: 24rpx;
}

.preview-icon {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  font-size: 40rpx;
  opacity: 0.5;
}

.template-info {
  flex: 1;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.template-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #4a4a4a;
  margin-bottom: 8rpx;
}

.template-desc {
  font-size: 24rpx;
  color: #aaa;
}

.check-mark {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e8a0a0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.confirm-btn {
  position: fixed;
  bottom: 40rpx;
  left: 32rpx;
  right: 32rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 34rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(232, 160, 160, 0.35);
}

.bottom-space {
  height: 140rpx;
}
