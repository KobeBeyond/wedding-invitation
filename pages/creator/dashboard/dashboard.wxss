/* pages/creator/dashboard/dashboard.wxss */
.dashboard {
  min-height: 100vh;
  background: linear-gradient(180deg, #fdf5f6 0%, #fff 30%);
  padding: 0 32rpx 60rpx;
}

.header {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.header-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #e8a0a0;
  letter-spacing: 4rpx;
}

.header-sub {
  font-size: 28rpx;
  color: #aaa;
  margin-top: 8rpx;
}

.create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
  border-radius: 48rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(232, 160, 160, 0.35);
  margin-bottom: 40rpx;
}

.create-icon {
  font-size: 40rpx;
  line-height: 1;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #aaa;
  font-size: 28rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #f0e0e0;
  border-top-color: #e8a0a0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 36rpx;
  color: #888;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #bbb;
  text-align: center;
  line-height: 1.6;
  padding: 0 40rpx;
}

.inv-list {
  padding-top: 8rpx;
}

.bottom-space {
  height: 40rpx;
}

/* 退出登录 */
.logout-bar {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.logout-text {
  font-size: 26rpx;
  color: #ccc;
  text-decoration: underline;
}

/* ===== 头像设置遮罩 ===== */
.avatar-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, #fdf5f6 0%, #fff 100%);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-panel {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #d45d5d;
  margin-bottom: 12rpx;
}

.avatar-sub {
  font-size: 28rpx;
  color: #aaa;
  margin-bottom: 80rpx;
}

.avatar-btn {
  width: 200rpx !important;
  height: 200rpx !important;
  min-width: 200rpx;
  min-height: 200rpx;
  max-width: 200rpx;
  max-height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  padding: 0 !important;
  margin: 0 0 40rpx 0;
  background: #fdf5f6;
  border: 4rpx solid #f0dcdc;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
  flex-shrink: 0;
  font-size: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: block;
}

.avatar-placeholder {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 64rpx;
  line-height: 1;
}

.avatar-hint {
  font-size: 24rpx;
  color: #ccc;
}

/* ===== 飘落花瓣 ===== */
.petal {
  position: absolute;
  top: -60rpx;
  font-size: 32rpx;
  opacity: 0.7;
  pointer-events: none;
  animation: fall linear infinite;
}

.p1 { left: 5%;  animation-duration: 6s; animation-delay: 0s;   font-size: 28rpx; }
.p2 { left: 15%; animation-duration: 8s; animation-delay: 1s;   font-size: 36rpx; }
.p3 { left: 25%; animation-duration: 7s; animation-delay: 2.5s; font-size: 24rpx; }
.p4 { left: 35%; animation-duration: 9s; animation-delay: 0.5s; font-size: 40rpx; }
.p5 { left: 45%; animation-duration: 6.5s; animation-delay: 3s;  font-size: 30rpx; }
.p6 { left: 55%; animation-duration: 8.5s; animation-delay: 1.5s; font-size: 34rpx; }
.p7 { left: 65%; animation-duration: 7.5s; animation-delay: 4s;   font-size: 26rpx; }
.p8 { left: 75%; animation-duration: 9.5s; animation-delay: 2s;   font-size: 38rpx; }
.p9 { left: 85%; animation-duration: 6s; animation-delay: 5s;    font-size: 32rpx; }
.p10 { left: 10%; animation-duration: 8s; animation-delay: 3.5s;  font-size: 28rpx; }
.p11 { left: 50%; animation-duration: 7s; animation-delay: 0.8s;  font-size: 36rpx; }
.p12 { left: 90%; animation-duration: 9s; animation-delay: 4.5s;  font-size: 30rpx; }

@keyframes fall {
  0%   { transform: translateY(0) rotate(0deg); opacity: 0.7; }
  20%  { opacity: 0.9; }
  80%  { opacity: 0.5; }
  100% { transform: translateY(120vh) rotate(360deg); opacity: 0; }
}

