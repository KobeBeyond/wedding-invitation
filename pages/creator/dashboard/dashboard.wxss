/* pages/creator/dashboard/dashboard.wxss */
.dashboard {
  min-height: 100vh;
  background: linear-gradient(180deg, #fdf5f6 0%, #fff 30%);
  padding: 0 32rpx 60rpx;
}

.header {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.header-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #e8a0a0;
  letter-spacing: 4rpx;
}

.header-sub {
  font-size: 28rpx;
  color: #aaa;
  margin-top: 8rpx;
}

.create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
  border-radius: 48rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(232, 160, 160, 0.35);
  margin-bottom: 40rpx;
}

.create-icon {
  font-size: 40rpx;
  line-height: 1;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #aaa;
  font-size: 28rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #f0e0e0;
  border-top-color: #e8a0a0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 36rpx;
  color: #888;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #bbb;
  text-align: center;
  line-height: 1.6;
  padding: 0 40rpx;
}

.inv-list {
  padding-top: 8rpx;
}

.bottom-space {
  height: 40rpx;
}

/* 退出登录 */
.logout-bar {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.logout-text {
  font-size: 26rpx;
  color: #ccc;
  text-decoration: underline;
}

/* ===== 头像设置遮罩 ===== */
.avatar-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, #fdf5f6 0%, #fff 100%);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-panel {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #d45d5d;
  margin-bottom: 12rpx;
}

.avatar-sub {
  font-size: 28rpx;
  color: #aaa;
  margin-bottom: 80rpx;
}

.avatar-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  padding: 0;
  margin: 0 0 40rpx 0;
  background: #fdf5f6;
  border: 4rpx solid #f0dcdc;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 64rpx;
}

.avatar-hint {
  font-size: 24rpx;
  color: #ccc;
}

