<!-- pages/creator/dashboard/dashboard.wxml -->
<view class="dashboard">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-title">Nupcias</view>
    <view class="header-sub">制作专属婚礼请柬</view>
  </view>

  <!-- 新建按钮 -->
  <view class="create-btn" bindtap="goCreate">
    <text class="create-icon">+</text>
    <text>新建请柬</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{isEmpty}}">
    <view class="empty-icon">💒</view>
    <view class="empty-title">还没有请柬</view>
    <view class="empty-desc">点击上方按钮，开始制作你的第一份婚礼请柬</view>
  </view>

  <!-- 请柬列表 -->
  <view class="inv-list" wx:else>
    <invitation-card
      wx:for="{{invitations}}"
      wx:key="_id"
      invitation="{{item}}"
      bind:view="onView"
      bind:edit="onEdit"
      bind:share="onShare"
      bind:delete="onDelete"
      bind:stats="onStats"
    />
  </view>

  <!-- 退出登录 -->
  <view class="logout-bar" bindtap="logout">
    <text class="logout-text">退出登录</text>
  </view>

  <view class="bottom-space"></view>
</view>

<!-- 头像设置遮罩 — 无头像时拦截 -->
<view class="avatar-mask" wx:if="{{showAvatarModal}}">
  <!-- 飘落花瓣 -->
  <view class="petal p1">🌸</view>
  <view class="petal p2">🌺</view>
  <view class="petal p3">🌸</view>
  <view class="petal p4">🌺</view>
  <view class="petal p5">🌸</view>
  <view class="petal p6">🌺</view>
  <view class="petal p7">🌸</view>
  <view class="petal p8">🌺</view>
  <view class="petal p9">🌸</view>
  <view class="petal p10">🌺</view>
  <view class="petal p11">🌸</view>
  <view class="petal p12">🌺</view>

  <view class="avatar-panel">
    <view class="avatar-title">欢迎使用 Nupcias</view>
    <view class="avatar-sub">请选择您的头像，开始使用</view>

    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onModalChooseAvatar">
      <image wx:if="{{modalAvatarUrl}}" src="{{modalAvatarUrl}}" class="avatar-img" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">
        <text class="avatar-icon">📷</text>
      </view>
    </button>

    <view class="avatar-hint">点击上方选择微信头像</view>
  </view>
</view>
