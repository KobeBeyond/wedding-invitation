<!-- pages/creator/dashboard/dashboard.wxml -->
<view class="dashboard">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-title">Nupcias</view>
    <view class="header-sub">制作专属婚礼请柬</view>
  </view>

  <!-- 新建按钮 -->
  <view class="create-btn" bindtap="goCreate">
    <text class="create-icon">+</text>
    <text>新建请柬</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{isEmpty}}">
    <view class="empty-icon">💒</view>
    <view class="empty-title">还没有请柬</view>
    <view class="empty-desc">点击上方按钮，开始制作你的第一份婚礼请柬</view>
  </view>

  <!-- 请柬列表 -->
  <view class="inv-list" wx:else>
    <invitation-card
      wx:for="{{invitations}}"
      wx:key="_id"
      invitation="{{item}}"
      bind:view="onView"
      bind:edit="onEdit"
      bind:share="onShare"
      bind:delete="onDelete"
      bind:stats="onStats"
    />
  </view>

  <!-- 退出登录 -->
  <view class="logout-bar" bindtap="logout">
    <text class="logout-text">退出登录</text>
  </view>

  <view class="bottom-space"></view>
</view>

<!-- 未登录遮罩 — 必须设置头像昵称才能使用 -->
<view class="login-mask" wx:if="{{!isLoggedIn}}">
  <view class="login-panel">
    <view class="login-title">欢迎来到 Nupcias</view>
    <view class="login-sub">请设置您的头像和昵称，开始使用婚礼请柬</view>

    <view class="login-avatar-row">
      <button class="login-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onLoginChooseAvatar">
        <image wx:if="{{loginAvatarUrl}}" src="{{loginAvatarUrl}}" class="login-avatar-img" mode="aspectFill" />
        <view wx:else class="login-avatar-placeholder">
          <text class="login-avatar-icon">📷</text>
          <text class="login-avatar-text">点击选头像</text>
        </view>
      </button>
    </view>

    <input
      class="login-nickname-input"
      type="nickname"
      placeholder="请输入昵称"
      value="{{loginNickName}}"
      bindinput="onLoginNickNameInput"
    />

    <view class="login-btn" bindtap="confirmLogin">进入小程序</view>
  </view>
</view>
