<!-- pages/guest/view/view.wxml — 来宾视角：完整长滚动请柬页面 -->
<view class="guest-view" wx:if="{{!loading && invitation}}" bindtap="onPageTap">

  <!-- ========== 第一屏：封面 ========== -->
  <view class="cover-section" style="height:100vh;">
    <image
      wx:if="{{invitation.coverImage}}"
      src="{{invitation.coverImage}}"
      mode="aspectFill"
      class="cover-bg"
    />
    <view wx:else class="cover-gradient"></view>

    <view class="cover-overlay"></view>

    <view class="cover-content">
      <view class="cover-names">
        <text class="name">{{invitation.groomName}}</text>
        <text class="ampersand">&</text>
        <text class="name">{{invitation.brideName}}</text>
      </view>

      <view class="cover-date">{{invitation.weddingDate}}</view>

      <!-- 倒计时 -->
      <view class="countdown" wx:if="{{!countdown.finished}}">
        <view class="countdown-label">距婚礼还有</view>
        <view class="countdown-grid">
          <view class="cd-item">
            <text class="cd-num">{{countdown.days}}</text>
            <text class="cd-unit">天</text>
          </view>
          <view class="cd-item">
            <text class="cd-num">{{countdown.hours}}</text>
            <text class="cd-unit">时</text>
          </view>
          <view class="cd-item">
            <text class="cd-num">{{countdown.minutes}}</text>
            <text class="cd-unit">分</text>
          </view>
          <view class="cd-item">
            <text class="cd-num">{{countdown.seconds}}</text>
            <text class="cd-unit">秒</text>
          </view>
        </view>
      </view>
      <view class="countdown-done" wx:else>🎉 婚礼进行中 🎉</view>
    </view>

    <!-- 下滑提示 -->
    <view class="scroll-hint" wx:if="{{!countdown.finished}}">
      <text class="scroll-text">下滑查看请柬</text>
      <view class="scroll-arrow"></view>
    </view>
  </view>

  <!-- 音乐开关 -->
  <view class="music-toggle {{playing ? 'playing' : ''}}" bindtap="toggleMusic" wx:if="{{invitation.musicUrl && showMusicBtn}}">
    <view class="music-icon">
      <view class="music-bar"></view>
      <view class="music-bar"></view>
      <view class="music-bar"></view>
    </view>
  </view>

  <!-- ========== 第二屏：新人介绍 ========== -->
  <view class="section intro-section" wx:if="{{invitation.groomIntro || invitation.brideIntro}}">
    <view class="section-header">
      <view class="header-line"></view>
      <text class="header-title">新郎 & 新娘</text>
      <view class="header-line"></view>
    </view>

    <view class="couple-cards">
      <view class="couple-card">
        <view class="couple-avatar groom-avatar">
          <text class="couple-initial">{{invitation.groomName ? invitation.groomName[0] : '他'}}</text>
        </view>
        <text class="couple-name">{{invitation.groomName}}</text>
        <text class="couple-intro" wx:if="{{invitation.groomIntro}}">{{invitation.groomIntro}}</text>
      </view>

      <view class="couple-heart">
        <text>❤</text>
      </view>

      <view class="couple-card">
        <view class="couple-avatar bride-avatar">
          <text class="couple-initial">{{invitation.brideName ? invitation.brideName[0] : '她'}}</text>
        </view>
        <text class="couple-name">{{invitation.brideName}}</text>
        <text class="couple-intro" wx:if="{{invitation.brideIntro}}">{{invitation.brideIntro}}</text>
      </view>
    </view>
  </view>

  <!-- ========== 第三屏：婚礼信息 ========== -->
  <view class="section wedding-info-section" wx:if="{{invitation.venueName || invitation.venueAddress}}">
    <view class="section-header">
      <view class="header-line"></view>
      <text class="header-title">婚礼地点</text>
      <view class="header-line"></view>
    </view>

    <view class="info-card">
      <view class="venue-name" wx:if="{{invitation.venueName}}">{{invitation.venueName}}</view>
      <view class="venue-hall" wx:if="{{invitation.venueHall}}">{{invitation.venueHall}}</view>

      <view class="info-row" wx:if="{{invitation.weddingDate}}">
        <text class="info-icon">📅</text>
        <view class="info-content">
          <text class="info-label">婚期</text>
          <text class="info-value">{{invitation.weddingDate}}</text>
        </view>
      </view>

      <view class="info-row" wx:if="{{invitation.venueAddress}}">
        <text class="info-icon">📍</text>
        <view class="info-content">
          <text class="info-label">地址</text>
          <text class="info-value">{{invitation.venueAddress}}</text>
        </view>
      </view>

      <view class="info-row" wx:if="{{invitation.venuePhone}}">
        <text class="info-icon">📞</text>
        <view class="info-content">
          <text class="info-label">电话</text>
          <text class="info-value" bindtap="callVenue">{{invitation.venuePhone}}</text>
        </view>
      </view>
    </view>

    <!-- 地图 -->
    <view class="map-wrap" wx:if="{{invitation.venueLat && invitation.venueLng}}">
      <map
        class="venue-map"
        longitude="{{invitation.venueLng}}"
        latitude="{{invitation.venueLat}}"
        markers="{{markers}}"
        scale="16"
        show-location
      ></map>
      <view class="map-nav-btn" bindtap="openNavigation">🧭 导航到这里</view>
    </view>
  </view>

  <!-- ========== 第四屏：婚纱照 + 弹幕 ========== -->
  <view class="section photos-section">
    <view class="section-header">
      <view class="header-line"></view>
      <text class="header-title">幸福瞬间</text>
      <view class="header-line"></view>
    </view>

    <!-- 弹幕覆盖层 -->
    <view class="gallery-stage">
      <!-- 有照片时展示轮播 -->
      <swiper
        wx:if="{{invitation.photos && invitation.photos.length > 0}}"
        class="photo-swiper"
        indicator-dots="{{true}}"
        indicator-color="rgba(232,160,160,0.3)"
        indicator-active-color="#e8a0a0"
        autoplay="{{true}}"
        interval="3500"
        duration="600"
        circular="{{true}}"
        current="{{photoIdx}}"
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{invitation.photos}}" wx:key="index">
          <view class="photo-item" bindtap="previewPhoto" data-idx="{{index}}">
            <image
              wx:if="{{item.url}}"
              src="{{item.url}}"
              mode="aspectFill"
              class="photo-img"
            />
          </view>
        </swiper-item>
      </swiper>

      <!-- 无照片时兜底 -->
      <view wx:else class="photo-fallback">
        <view class="fallback-heart">❤</view>
        <text class="fallback-text">幸福瞬间 敬请期待</text>
        <text class="fallback-sub">新人照片上传后将展示在这里</text>
      </view>

      <!-- 弹幕层 -->
      <view class="gallery-danmaku-overlay">
        <danmaku id="danmaku"></danmaku>
      </view>
    </view>

    <!-- 缩略图（仅有照片时显示） -->
    <view class="thumb-strip" wx:if="{{invitation.photos && invitation.photos.length > 0}}">
      <view
        class="thumb-item {{photoIdx === index ? 'active' : ''}}"
        wx:for="{{invitation.photos}}"
        wx:key="index"
        data-idx="{{index}}"
        bindtap="tapThumbnail"
      >
        <image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" class="thumb-img" />
      </view>
    </view>
  </view>

  <!-- ========== 第五屏：婚礼流程 ========== -->
  <view class="section timeline-section">
    <view class="section-header">
      <view class="header-line"></view>
      <text class="header-title">婚礼流程</text>
      <view class="header-line"></view>
    </view>

    <view class="timeline">
      <view
        class="timeline-item"
        wx:for="{{invitation.timeline}}"
        wx:key="index"
      >
        <view class="time-col">
          <view class="time-badge">
            <text class="time-text">{{item.time}}</text>
          </view>
          <view class="time-line" wx:if="{{index < invitation.timeline.length - 1}}"></view>
        </view>

        <view class="content-col">
          <view class="content-card">
            <view class="content-header">
              <text class="content-title">{{item.title}}</text>
            </view>
            <text class="content-desc" wx:if="{{item.description}}">{{item.description}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 第六屏：来宾回执 ========== -->
  <view class="section rsvp-section">
    <view class="section-header">
      <view class="header-line"></view>
      <text class="header-title">来宾回执</text>
      <view class="header-line"></view>
    </view>

    <!-- 表单 -->
    <view class="rsvp-form" wx:if="{{!rsvpSubmitted}}">
      <view class="rsvp-intro">请填写您的出席信息</view>

      <view class="form-item">
        <text class="form-label">姓名 <text class="required">*</text></text>
        <input class="form-input" placeholder="请输入您的姓名" value="{{rsvpForm.name}}"
               bindinput="onRsvpInput" data-field="name" maxlength="20" />
      </view>

      <view class="form-item">
        <text class="form-label">电话 <text class="required">*</text></text>
        <input class="form-input" type="number" placeholder="请输入手机号码" value="{{rsvpForm.phone}}"
               bindinput="onRsvpInput" data-field="phone" maxlength="11" />
      </view>

      <view class="form-item">
        <text class="form-label">是否出席 <text class="required">*</text></text>
        <radio-group bindchange="onAttendingChange">
          <label class="radio-label {{rsvpForm.attending === 'yes' ? 'checked' : ''}}">
            <radio value="yes" checked="{{rsvpForm.attending === 'yes'}}" color="#e8a0a0" />
            <text>一定出席</text>
          </label>
          <label class="radio-label {{rsvpForm.attending === 'no' ? 'checked' : ''}}">
            <radio value="no" checked="{{rsvpForm.attending === 'no'}}" color="#e8a0a0" />
            <text>无法出席</text>
          </label>
        </radio-group>
      </view>

      <view class="form-item" wx:if="{{rsvpForm.attending === 'yes'}}">
        <text class="form-label">出席人数</text>
        <picker bindchange="onGuestCountChange" value="{{guestCountIndex}}" range="{{guestCountOptions}}">
          <view class="picker-value">
            <text>{{guestCountOptions[guestCountIndex]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="form-item" wx:if="{{rsvpForm.attending === 'yes'}}">
        <text class="form-label">是否有同来人员 <text class="form-hint">（订酒店用）</text></text>
        <radio-group bindchange="onHasCompanionChange">
          <label class="radio-label {{hasCompanion === 'yes' ? 'checked' : ''}}">
            <radio value="yes" checked="{{hasCompanion === 'yes'}}" color="#e8a0a0" />
            <text>有</text>
          </label>
          <label class="radio-label {{hasCompanion === 'no' ? 'checked' : ''}}">
            <radio value="no" checked="{{hasCompanion === 'no'}}" color="#e8a0a0" />
            <text>无</text>
          </label>
        </radio-group>
      </view>

      <view class="form-item" wx:if="{{rsvpForm.attending === 'yes' && hasCompanion === 'yes'}}">
        <text class="form-label">同来人员数量</text>
        <picker bindchange="onCompanionCountChange" value="{{companionCountIndex}}" range="{{companionCountOptions}}">
          <view class="picker-value">
            <text>{{companionCountOptions[companionCountIndex]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">饮食偏好</text>
        <textarea class="form-textarea" placeholder="如有特殊饮食需求请告知（如素食、过敏等）"
                  value="{{rsvpForm.dietary}}" bindinput="onRsvpInput" data-field="dietary"
                  maxlength="100" auto-height />
      </view>

      <button class="rsvp-submit-btn" bindtap="submitRSVP" disabled="{{rsvpSubmitting}}">
        <text wx:if="{{!rsvpSubmitting}}">提交回执</text>
        <text wx:else>提交中...</text>
      </button>
    </view>

    <!-- 提交成功 -->
    <view class="rsvp-success" wx:if="{{rsvpSubmitted}}">
      <view class="success-check">
        <view class="check-circle"></view>
        <text class="check-mark">✓</text>
      </view>
      <text class="success-title">感谢您的回复！</text>
      <text class="success-desc">{{rsvpForm.attending === 'yes' ? '期待在婚礼上与您相见' : '感谢您的关注，我们已收到您的回执'}}</text>
    </view>
  </view>

  <!-- ========== 第七屏：祝福墙 ========== -->
  <view class="section blessings-section">
    <view class="section-header">
      <view class="header-line"></view>
      <text class="header-title">祝福墙</text>
      <view class="header-line"></view>
    </view>

    <!-- 祝福统计 -->
    <view class="blessing-stats">
      <view class="blessing-count" wx:if="{{blessingCount > 0}}">
        已收到 {{blessingCount}} 条祝福
      </view>

      <view class="blessing-empty" wx:if="{{blessingCount === 0 && !blessingsLoading}}">
        <text class="empty-icon">💌</text>
        <text class="empty-text">还没有祝福，快来写下第一条吧</text>
      </view>
    </view>

    <!-- 输入栏 -->
    <view class="blessing-input-bar">
      <input class="blessing-input" placeholder="写下你的祝福..." value="{{blessingText}}"
             bindinput="onBlessingInput" confirm-type="send" bindconfirm="sendBlessing"
             maxlength="50" />
      <view class="blessing-send-btn {{blessingText.trim() ? 'active' : ''}}" bindtap="sendBlessing">
        发送
      </view>
    </view>
  </view>

  <!-- ========== 底部 ========== -->
  <view class="footer-section">
    <view class="footer-deco">
      <view class="footer-line"></view>
      <text class="footer-heart">❤</text>
      <view class="footer-line"></view>
    </view>
    <text class="footer-couple">{{invitation.groomName}} & {{invitation.brideName}}</text>
    <text class="footer-date">{{invitation.weddingDate}}</text>

    <!-- 分享按钮 -->
    <view class="footer-actions">
      <button class="share-btn" open-type="share">
        <text class="share-icon">💌</text>
        <text class="share-text">分享给好友</text>
      </button>
    </view>

    <view class="create-cta" bindtap="goCreate">
      我也要制作请柬 →
    </view>
  </view>

</view>

<!-- 加载中 -->
<view class="loading-state" wx:else>
  <view class="loading-spinner"></view>
  <text>加载请柬中...</text>
</view>
