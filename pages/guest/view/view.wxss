/* pages/guest/view/view.wxss — 来宾视角完整样式 */
page {
  background: #fdf5f6;
}

.guest-view {
  min-height: 100vh;
  background: #fdf5f6;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 通用 Section ========== */
.section {
  padding: 60rpx 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.header-line {
  width: 64rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #d4af37, transparent);
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #8a6d4f;
  letter-spacing: 4rpx;
}

/* ========== 第一屏：封面 ========== */
.cover-section {
  position: relative;
  overflow: hidden;
}

.cover-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}

.cover-gradient {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, #e8a0a0 0%, #d4af37 100%);
}

.cover-overlay {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.25);
}

.cover-content {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  padding-top: 120rpx;
}

.cover-names {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.name {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.4);
}

.ampersand {
  font-size: 56rpx;
  color: #ffd700;
  font-style: italic;
}

.cover-date {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 48rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 倒计时 */
.countdown {
  text-align: center;
}

.countdown-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.countdown-grid {
  display: flex;
  gap: 20rpx;
}

.cd-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  backdrop-filter: blur(8rpx);
  min-width: 80rpx;
}

.cd-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.cd-unit {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.countdown-done {
  font-size: 40rpx;
  color: #fff;
  font-weight: 600;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

/* 下滑提示 */
.scroll-hint {
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 3;
  animation: bounce 2s ease-in-out infinite;
}

.scroll-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}

.scroll-arrow {
  width: 20rpx;
  height: 20rpx;
  border-right: 4rpx solid rgba(255, 255, 255, 0.6);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.6);
  transform: rotate(45deg);
}

@keyframes bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(16rpx); }
}

/* ========== 音乐开关 ========== */
.music-toggle {
  position: fixed;
  top: 200rpx;
  right: 32rpx;
  z-index: 100;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.music-icon {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 32rpx;
}

.music-bar {
  width: 6rpx;
  height: 16rpx;
  background: #e8a0a0;
  border-radius: 3rpx;
}

.music-toggle.playing .music-bar {
  animation: musicBar 0.6s ease-in-out infinite;
}

.music-toggle.playing .music-bar:nth-child(2) {
  animation-delay: 0.2s;
}

.music-toggle.playing .music-bar:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes musicBar {
  0%, 100% { height: 16rpx; }
  50% { height: 32rpx; }
}

/* ========== 第二屏：新人介绍 ========== */
.intro-section {
  background: #fdf5f6;
}

.couple-cards {
  display: flex;
  align-items: stretch;
  gap: 24rpx;
}

.couple-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.couple-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.couple-avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.groom-avatar {
  background: linear-gradient(135deg, #6bb4e8, #4a9fde);
}

.bride-avatar {
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
}

.couple-initial {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.couple-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.couple-intro {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
  text-align: center;
}

.couple-heart {
  display: flex;
  align-items: center;
  font-size: 40rpx;
  color: #e8a0a0;
}

/* ========== 第三屏：婚礼信息 ========== */
.wedding-info-section {
  background: #fff;
}

.info-card {
  background: #fdf5f6;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
}

.venue-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 8rpx;
}

.venue-hall {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx dashed #e8d0d0;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.info-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.info-label {
  font-size: 24rpx;
  color: #aaa;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 地图 */
.map-wrap {
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.venue-map {
  width: 100%;
  height: 360rpx;
}

.map-nav-btn {
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
  color: #fff;
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
}

/* ========== 第四屏：婚纱照 + 弹幕 ========== */
.photos-section {
  background: #fdf5f6;
  padding-bottom: 60rpx;
}

.gallery-stage {
  position: relative;
  width: 100%;
  height: 480rpx;
  overflow: visible;
}

.gallery-danmaku-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  pointer-events: none;
}

/* 堆叠卡片轮播 */
.card-swiper {
  width: 100%;
  height: 100%;
}

/* swiper 指示器：放到图片下方，不遮挡 */
.card-swiper .wx-swiper-dots {
  bottom: -44rpx;
}

.card-swiper .wx-swiper-dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 8rpx;
  border-radius: 50%;
}

.card-swiper .wx-swiper-dot-active {
  width: 24rpx;
  border-radius: 6rpx;
}

.card-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s ease, opacity 0.3s ease;
  transform: scale(0.88);
  opacity: 0.55;
}

.card-item.active {
  transform: scale(1);
  opacity: 1;
}

.card-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  background: #f5f0f0;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
}

/* 无照片时兜底 */
.photo-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fce8ec, #f5d5d5, #e8c4c4);
  border-radius: 20rpx;
}

.fallback-heart {
  font-size: 80rpx;
  color: #e8a0a0;
  margin-bottom: 20rpx;
  animation: heartbeat 2s ease-in-out infinite;
}

@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.15); }
}

.fallback-text {
  font-size: 36rpx;
  color: #c07070;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.fallback-sub {
  font-size: 24rpx;
  color: #c09999;
}

/* ========== 第五屏：婚礼流程 ========== */
.timeline-section {
  background: #fff;
}

.timeline {
  padding: 0 16rpx;
}

.timeline-item {
  display: flex;
  gap: 24rpx;
}

.time-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.time-badge {
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  min-width: 96rpx;
  text-align: center;
}

.time-line {
  width: 2rpx;
  flex: 1;
  background: #e8d0d0;
  margin: 8rpx 0;
  min-height: 48rpx;
}

.content-col {
  flex: 1;
  padding-bottom: 32rpx;
}

.content-card {
  background: #fdf5f6;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}

.content-header {
  margin-bottom: 8rpx;
}

.content-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.content-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
}

/* ========== 第六屏：来宾回执 ========== */
.rsvp-section {
  background: #fdf5f6;
}

.rsvp-intro {
  font-size: 28rpx;
  color: #888;
  text-align: center;
  margin-bottom: 40rpx;
}

.rsvp-form {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
font-size: 28rpx;
color: #555;
font-weight: 500;
display: block;
margin-bottom: 12rpx;
}

.form-hint {
font-size: 24rpx;
color: #b0a0a0;
font-weight: 400;
}

.required {
  color: #e8a0a0;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f9f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  background: #f9f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  min-height: 120rpx;
  box-sizing: border-box;
}

.radio-label {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-right: 48rpx;
  padding: 12rpx 24rpx;
  background: #f9f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #555;
  transition: all 0.3s;
}

.radio-label.checked {
  background: #fce8e8;
  color: #d97a7a;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  background: #f9f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  color: #ccc;
  font-size: 32rpx;
}

.rsvp-submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.rsvp-submit-btn::after {
  border: none;
}

.rsvp-submit-btn[disabled] {
  opacity: 0.6;
}

/* 回执成功 */
.rsvp-success {
  background: #fff;
  border-radius: 20rpx;
  padding: 64rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.success-check {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
}

.check-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #4caf50;
  opacity: 0.15;
}

.check-mark {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 64rpx;
  color: #4caf50;
  font-weight: 700;
}

.success-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #888;
}

/* ========== 第七屏：祝福墙 ========== */
.blessings-section {
  background: #fff;
}

.blessing-stats {
  padding: 20rpx 0;
  text-align: center;
}

.blessing-count {
  display: inline-block;
  font-size: 26rpx;
  color: #e8a0a0;
  background: #fdf5f6;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.blessing-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #aaa;
}

.blessing-input-bar {
  display: flex;
  gap: 10rpx;
  margin-top: 24rpx;
  align-items: center;
}

/* 头像选择按钮 */
.blessing-avatar-btn {
  flex-shrink: 0;
  width: 64rpx!important;
  height: 64rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  border-radius: 50%;
}

.blessing-avatar-btn::after {
  border: none;
}

.blessing-avatar-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid #e8a0a0;
}

.blessing-avatar-placeholder {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f9f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e8a0a0;
}

.blessing-avatar-icon {
  font-size: 36rpx;
}

.blessing-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  background: #f9f5f5;
  border-radius: 32rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
}

.blessing-send-btn {
  flex-shrink: 0;
  width: 96rpx;
  height: 64rpx;
  background: #e0e0e0;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  transition: background 0.3s;
}

.blessing-send-btn.active {
  background: #c98d8d;
}

.blessing-list {
  margin-top: 24rpx;
}

.blessing-list-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0e0e0;
}

.blessing-list-item:last-child {
  border-bottom: none;
}

.blessing-list-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.blessing-list-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e8a0a0, #d48888);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.blessing-list-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.blessing-send-btn {
  flex-shrink: 0;
  height: 80rpx;
  padding: 0 32rpx;
  background: #e0e0e0;
  color: #999;
  font-size: 28rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.blessing-send-btn.active {
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
  color: #fff;
}

/* ========== 底部 ========== */
.footer-section {
  background: #fdf5f6;
  padding: 64rpx 32rpx 120rpx;
  text-align: center;
}

.footer-deco {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.footer-line {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #d4af37, transparent);
}

.footer-heart {
  font-size: 32rpx;
  color: #e8a0a0;
}

.footer-couple {
  font-size: 32rpx;
  font-weight: 600;
  color: #8a6d4f;
  margin-bottom: 8rpx;
}

.footer-date {
  font-size: 26rpx;
  color: #b09080;
  margin-bottom: 48rpx;
}

.footer-actions {
  margin-bottom: 40rpx;
}

.share-btn {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
  color: #fff !important;
  font-size: 30rpx;
  padding: 24rpx 64rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(232, 160, 160, 0.35);
  line-height: 1.5;
}

.share-btn::after {
  border: none;
}

.share-icon {
  font-size: 32rpx;
}

.create-cta {
  font-size: 28rpx;
  color: #b09080;
  text-decoration: underline;
  padding: 16rpx;
}

/* ========== 加载状态 ========== */
.loading-state {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fdf5f6;
  color: #aaa;
  font-size: 28rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #f0e0e0;
  border-top-color: #e8a0a0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
