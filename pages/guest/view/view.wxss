/* pages/guest/view/view.wxss */
.guest-view {
  min-height: 100vh;
  background: #fdf5f6;
}

/* 封面区 */
.cover-section {
  position: relative;
  height: 70vh;
  min-height: 600rpx;
}

.cover-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-gradient {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #e8a0a0 0%, #d4af37 100%);
}

.cover-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  padding-top: 120rpx;
  background: rgba(0, 0, 0, 0.2);
}

.cover-names {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.name {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

.ampersand {
  font-size: 56rpx;
  color: #ffd700;
  font-style: italic;
}

.cover-date {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 48rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 倒计时 */
.countdown {
  text-align: center;
}

.countdown-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.countdown-grid {
  display: flex;
  gap: 24rpx;
}

.cd-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  backdrop-filter: blur(8rpx);
}

.cd-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.cd-unit {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.countdown-done {
  font-size: 40rpx;
  color: #fff;
  font-weight: 600;
}

/* 导航卡片 */
.nav-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 40rpx 32rpx;
}

.nav-card {
  width: calc(33.33% - 14rpx);
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.nav-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.nav-label {
  font-size: 26rpx;
  color: #666;
}

/* CTA */
.cta-section {
  text-align: center;
  padding: 48rpx 32rpx 80rpx;
}

.cta-text {
  font-size: 30rpx;
  color: #888;
  margin-bottom: 24rpx;
}

.cta-btn {
  display: inline-block;
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
  color: #fff;
  font-size: 32rpx;
  border-radius: 48rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(232, 160, 160, 0.35);
}

/* 加载状态 */
.loading-state {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fdf5f6;
  color: #aaa;
  font-size: 28rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #f0e0e0;
  border-top-color: #e8a0a0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
