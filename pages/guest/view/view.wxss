/* pages/guest/view/view.wxss — 来宾视角完整样式 */
page {
  background: #fdf5f6;
}

.guest-view {
  min-height: 100vh;
  background: #fdf5f6;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 通用 Section ========== */
.section {
  padding: 60rpx 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.header-line {
  width: 64rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #d4af37, transparent);
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #8a6d4f;
  letter-spacing: 4rpx;
}

/* ========== 第一屏：封面 ========== */
.cover-section {
  position: relative;
  overflow: hidden;
}

.cover-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  opacity: 0;
  transform: scale(1.06);
  filter: blur(4rpx);
  transition: opacity 0.8s ease-out, transform 1.2s ease-out, filter 1s ease-out;
}

.cover-bg.loaded {
  opacity: 1;
  transform: scale(1);
  filter: blur(0);
}

.cover-gradient {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, #e8a0a0 0%, #d4af37 100%);
}

/* 封面加载动画 — 径向渐变背景 + 双戒指旋转 + 金色粒子 */
.cover-loading {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 50% 42%, #c41e3a 0%, #a01030 40%, #6b0a1e 100%);
  z-index: 9999;
  transition: opacity 0.5s ease-in 0.15s, transform 0.6s ease-in 0.1s;
  overflow: hidden;
}

.cover-loading.hidden {
  opacity: 0;
  pointer-events: none;
  transform: scale(0.96);
}

/* 双戒指 */
.rings-loader {
  width: 180rpx;
  height: 180rpx;
  position: relative;
  animation: ringSpin 4s linear infinite;
  will-change: transform;
  backface-visibility: hidden;
}

.ring {
  position: absolute;
  width: 108rpx;
  height: 108rpx;
  border: 6rpx solid #e8c05a;
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.35), 0 0 10rpx rgba(232, 192, 90, 0.3);
  backface-visibility: hidden;
}

/* 对称分布：重心正好在 loader 中心 (90,90)，消除旋转 wobble */
.ring-1 {
  top: 14rpx;
  left: 14rpx;
}

.ring-2 {
  top: 58rpx;
  left: 58rpx;
}

@keyframes ringSpin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* 品牌文字 */
.loading-brand {
  margin-top: 60rpx;
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 10rpx;
  font-weight: 300;
  animation: brandFade 2.5s ease-in-out infinite alternate;
}

@keyframes brandFade {
  from { opacity: 0.35; }
  to   { opacity: 1; }
}

/* 金色粒子 */
.loading-particles {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
}

.particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: #e8c05a;
  border-radius: 50%;
  opacity: 0;
  box-shadow: 0 0 8rpx rgba(232, 192, 90, 0.8);
}

.pa1  { left: 8%;  animation: particleUp 5s linear infinite; animation-delay: 0s;    }
.pa2  { left: 18%; animation: particleUp 7s linear infinite; animation-delay: 1.2s;  width: 4rpx; height: 4rpx; }
.pa3  { left: 28%; animation: particleUp 6s linear infinite; animation-delay: 2.5s;  }
.pa4  { left: 38%; animation: particleUp 8s linear infinite; animation-delay: 0.8s;  width: 8rpx; height: 8rpx; }
.pa5  { left: 48%; animation: particleUp 5.5s linear infinite; animation-delay: 3.2s; }
.pa6  { left: 58%; animation: particleUp 7.5s linear infinite; animation-delay: 1.8s; width: 4rpx; height: 4rpx; }
.pa7  { left: 68%; animation: particleUp 6.5s linear infinite; animation-delay: 4s;   }
.pa8  { left: 78%; animation: particleUp 9s linear infinite; animation-delay: 2.2s;   width: 8rpx; height: 8rpx; }
.pa9  { left: 88%; animation: particleUp 5s linear infinite; animation-delay: 0.5s;   }
.pa10 { left: 15%; animation: particleUp 8s linear infinite; animation-delay: 3.8s;   width: 4rpx; height: 4rpx; }
.pa11 { left: 65%; animation: particleUp 6s linear infinite; animation-delay: 5s;     }
.pa12 { left: 85%; animation: particleUp 7s linear infinite; animation-delay: 1s;     width: 8rpx; height: 8rpx; }

@keyframes particleUp {
  0%   { transform: translateY(100vh) scale(0); opacity: 0; }
  10%  { opacity: 0.9; }
  90%  { opacity: 0.2; }
  100% { transform: translateY(-20rpx) scale(1); opacity: 0; }
}

/* 全页 loading */
.cover-loading.full-page {
  position: fixed;
}

/* ===== 飘落花瓣彩蛋层 ===== */
.petal-layer {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100vh;
  pointer-events: none; /* 层本身不拦截事件 */
  z-index: 60;
  overflow: hidden;
}

.g-petal {
  position: absolute;
  top: -60rpx;
  width: 22rpx;
  height: 34rpx;
  background: linear-gradient(180deg, #ffb7c5 0%, #ff8da1 60%, #ff6b8a 100%);
  border-radius: 50% 50% 50% 50% / 65% 65% 35% 35%;
  pointer-events: auto; /* 花瓣本身可点击 */
  animation: petalFall linear infinite;
  transform-origin: center bottom;
  box-shadow: 0 2rpx 6rpx rgba(255, 107, 138, 0.25);
}

/* 点击反馈：放大提示可点 */
.g-petal:active {
transform: scale(1.6);
}

/* 被点碎的花瓣：立即消失（碎裂效果由 burst 粒子承接） */
.petal-gone {
display: none;
}

/* 10 片花瓣：位置 / 大小 / 时长 / 延迟各不相同，色彩略有差异 */
.gp1  { left: 4%;  animation-duration: 8s;   animation-delay: 0s;    width: 20rpx; height: 30rpx; }
.gp2  { left: 13%; animation-duration: 11s;  animation-delay: 1.5s;  width: 26rpx; height: 38rpx; background: linear-gradient(180deg, #ffd1dc 0%, #ffb7c5 100%); }
.gp3  { left: 22%; animation-duration: 9.5s; animation-delay: 3s;    width: 18rpx; height: 28rpx; opacity: 0.85; }
.gp4  { left: 31%; animation-duration: 12s;  animation-delay: 0.8s;  width: 28rpx; height: 42rpx; }
.gp5  { left: 41%; animation-duration: 10s;  animation-delay: 4.2s;  width: 22rpx; height: 34rpx; background: linear-gradient(180deg, #ffd1dc 0%, #ffb7c5 100%); opacity: 0.9; }
.gp6  { left: 51%; animation-duration: 13s;  animation-delay: 2s;    width: 24rpx; height: 36rpx; }
.gp7  { left: 61%; animation-duration: 9s;   animation-delay: 5s;    width: 20rpx; height: 30rpx; opacity: 0.8; }
.gp8  { left: 70%; animation-duration: 11.5s; animation-delay: 1.2s; width: 26rpx; height: 40rpx; background: linear-gradient(180deg, #ffd1dc 0%, #ffb7c5 100%); }
.gp9  { left: 80%; animation-duration: 8.5s; animation-delay: 3.6s;  width: 22rpx; height: 34rpx; opacity: 0.85; }
.gp10 { left: 91%; animation-duration: 12.5s; animation-delay: 0.4s; width: 24rpx; height: 36rpx; opacity: 0.9; }

@keyframes petalFall {
  0%   { transform: translateY(0) rotate(0deg) rotateX(0deg); opacity: 0; }
  8%   { opacity: 0.9; }
  85%  { opacity: 0.5; }
  100% { transform: translateY(110vh) rotate(320deg) rotateX(200deg); opacity: 0; }
}

/* 花瓣点击彩蛋气泡：锚定在花瓣点击位置（JS 传入 left/top px） */
.petal-bubble {
  position: fixed;
  transform: translate(-50%, -130%) scale(0.4);
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid #ffb7c5;
  border-radius: 32rpx;
  padding: 20rpx 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 138, 0.25);
  z-index: 9998;
  opacity: 0;
  transition: opacity 0.35s ease-out, transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  pointer-events: none;
  max-width: 80vw;
  box-sizing: border-box;
}

.petal-bubble.show {
  opacity: 1;
  transform: translate(-50%, -130%) scale(1);
}

.petal-bubble-text {
  font-size: 28rpx;
  color: #c94f6d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}

/* ===== 花瓣炸碎烟花 ===== */
.petal-burst {
  position: fixed;
  width: 0;
  height: 0;
  z-index: 9997;
  pointer-events: none;
}

.burst-particle {
  position: absolute;
  left: 0;
  top: 0;
  width: 14rpx;
  height: 14rpx;
  background: linear-gradient(135deg, #ffb7c5, #ff6b8a);
  border-radius: 50% 50% 50% 50% / 65% 65% 35% 35%; /* 花瓣碎片形状 */
  animation: burstFly 0.8s cubic-bezier(0.16, 0.84, 0.44, 1) forwards;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 138, 0.5);
}

/* 8 个碎片向不同方向飞散 */
.bp1 { animation-delay: 0s;    --dx: -120rpx; --dy: -100rpx; }
.bp2 { animation-delay: 0.02s; --dx: 0rpx;    --dy: -140rpx; }
.bp3 { animation-delay: 0.04s; --dx: 120rpx;  --dy: -100rpx; }
.bp4 { animation-delay: 0s;    --dx: -150rpx; --dy: 0rpx; }
.bp5 { animation-delay: 0.02s; --dx: 150rpx;  --dy: 0rpx; }
.bp6 { animation-delay: 0.04s; --dx: -100rpx; --dy: 110rpx; }
.bp7 { animation-delay: 0s;    --dx: 0rpx;    --dy: 150rpx; }
.bp8 { animation-delay: 0.02s; --dx: 100rpx;  --dy: 110rpx; }

@keyframes burstFly {
  0% {
    transform: translate(0, 0) scale(1) rotate(0deg);
    opacity: 1;
  }
  60% {
    opacity: 1;
  }
  100% {
    transform: translate(var(--dx), var(--dy)) scale(0.3) rotate(360deg);
    opacity: 0;
  }
}

.cover-bg.loaded {
  opacity: 1;
}

.cover-overlay {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.25);
}

.cover-content {
  position: absolute;
  bottom: 320rpx;
  left: 0;
  right: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 64rpx;
}

.cover-names {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.name {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.4);
}

.ampersand {
  font-size: 56rpx;
  color: #fff;
  font-style: italic;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.4);
}

.cover-date {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 48rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 倒计时 */
.countdown {
  text-align: center;
}

.countdown-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.countdown-grid {
  display: flex;
  gap: 20rpx;
}

.cd-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  backdrop-filter: blur(8rpx);
  min-width: 80rpx;
}

.cd-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.cd-unit {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.countdown-done {
  font-size: 40rpx;
  color: #fff;
  font-weight: 600;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

/* 下滑提示 */
.scroll-hint {
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 3;
  animation: bounce 2s ease-in-out infinite;
}

.scroll-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}

.scroll-arrow {
  width: 20rpx;
  height: 20rpx;
  border-right: 4rpx solid rgba(255, 255, 255, 0.6);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.6);
  transform: rotate(45deg);
}

@keyframes bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(16rpx); }
}

/* ========== 音乐开关 ========== */
.music-toggle {
  position: fixed;
  top: 200rpx;
  right: 32rpx;
  z-index: 100;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.music-icon {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 32rpx;
}

.music-bar {
  width: 6rpx;
  height: 16rpx;
  background: #e8a0a0;
  border-radius: 3rpx;
}

.music-toggle.playing .music-bar {
  animation: musicBar 0.6s ease-in-out infinite;
}

.music-toggle.playing .music-bar:nth-child(2) {
  animation-delay: 0.2s;
}

.music-toggle.playing .music-bar:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes musicBar {
  0%, 100% { height: 16rpx; }
  50% { height: 32rpx; }
}

/* ========== 第二屏：新人介绍 ========== */
.intro-section {
  background: #fdf5f6;
}

.couple-cards {
  display: flex;
  align-items: stretch;
  gap: 24rpx;
}

.couple-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.couple-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.couple-avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.groom-avatar {
  background: linear-gradient(135deg, #6bb4e8, #4a9fde);
}

.bride-avatar {
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
}

.couple-initial {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.couple-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.couple-intro {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
  text-align: center;
}

.couple-heart {
  display: flex;
  align-items: center;
  font-size: 40rpx;
  color: #e8a0a0;
}

/* ========== 第三屏：婚礼信息 ========== */
.wedding-info-section {
  background: #fff;
}

.info-card {
  background: #fdf5f6;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
}

.venue-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 8rpx;
}

.venue-hall {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx dashed #e8d0d0;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.info-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.info-label {
  font-size: 24rpx;
  color: #aaa;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 地图 */
.map-wrap {
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.venue-map {
  width: 100%;
  height: 360rpx;
}

.map-nav-btn {
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
  color: #fff;
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
}

/* ========== 第四屏：婚纱照 + 弹幕 ========== */
.photos-section {
  background: linear-gradient(180deg, #fdf5f6 0%, #fce8ec 50%, #fdf5f6 100%);
  position: relative;
}

/* 花朵装饰背景纹理 */
.photos-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: radial-gradient(circle, rgba(232, 160, 160, 0.15) 1.5rpx, transparent 1.5rpx);
  background-size: 24rpx 24rpx;
  pointer-events: none;
  z-index: 0;
}

.gallery-stage {
  position: relative;
  width: 100%;
  height: 480rpx;
  overflow: visible;
  z-index: 1;
}

.gallery-danmaku-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  pointer-events: none;
}

/* 堆叠卡片轮播 */
.card-swiper {
  width: 100%;
  height: 100%;
}

/* 自定义指示器 */
.custom-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-bottom: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(232, 160, 160, 0.35);
  transition: width 0.25s ease, background 0.25s ease;
}

.dot.active {
  width: 28rpx;
  border-radius: 6rpx;
  background: #e8a0a0;
}

.card-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  will-change: transform;
  padding: 16rpx;
  box-sizing: border-box;
}

.card-item.active .card-img {
  transform: scale(1);
  opacity: 1;
}

.card-item:not(.active) .card-img {
  transform: scale(0.9);
  opacity: 0.6;
}

/* 花朵相框样式：双层边框 + 四角小花装饰 + 留白区花瓣纹理 */
.card-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  transition: transform 0.25s ease-out, opacity 0.25s ease-out;
  will-change: transform, opacity;
  border: 6rpx solid #fff;
  box-shadow: 0 0 0 3rpx #e8a0a0, 0 8rpx 32rpx rgba(200, 100, 100, 0.15);
  position: relative;
  /* 横图/竖图留白区域：淡淡的花瓣纹理背景 */
  background:
    radial-gradient(circle at 20% 30%, rgba(232, 160, 160, 0.22) 0%, transparent 8%),
    radial-gradient(circle at 70% 60%, rgba(244, 143, 177, 0.18) 0%, transparent 10%),
    radial-gradient(circle at 40% 80%, rgba(232, 160, 160, 0.20) 0%, transparent 7%),
    radial-gradient(circle at 80% 20%, rgba(244, 143, 177, 0.15) 0%, transparent 9%),
    radial-gradient(circle at 10% 70%, rgba(232, 160, 160, 0.18) 0%, transparent 6%),
    radial-gradient(circle at 60% 40%, rgba(248, 187, 208, 0.12) 0%, transparent 8%),
    radial-gradient(circle at 30% 50%, rgba(244, 143, 177, 0.14) 0%, transparent 7%),
    #fdf5f6;
}

/* 四角花朵装饰 */
.card-img::before,
.card-img::after {
  content: '🌸';
  position: absolute;
  font-size: 24rpx;
  line-height: 1;
  z-index: 2;
}

.card-img::before {
  top: -10rpx;
  left: -10rpx;
}

.card-img::after {
  bottom: -10rpx;
  right: -10rpx;
}

/* 无照片时兜底 */
.photo-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fce8ec, #f5d5d5, #e8c4c4);
  border-radius: 20rpx;
}

.fallback-heart {
  font-size: 80rpx;
  color: #e8a0a0;
  margin-bottom: 20rpx;
  animation: heartbeat 2s ease-in-out infinite;
}

@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.15); }
}

.fallback-text {
  font-size: 36rpx;
  color: #c07070;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.fallback-sub {
  font-size: 24rpx;
  color: #c09999;
}

/* ========== 第五屏：婚礼流程 ========== */
.timeline-section {
  background: #fff;
}

.timeline {
  padding: 0 16rpx;
}

.timeline-toggle {
  margin: 24rpx auto 0;
  width: fit-content;
  padding: 14rpx 40rpx;
  border-radius: 36rpx;
  background: #fdf5f6;
  border: 2rpx solid #f0dcdc;
  font-size: 26rpx;
  color: #c07070;
  text-align: center;
}

.timeline-item {
  display: flex;
  gap: 24rpx;
}

.time-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.time-badge {
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  min-width: 96rpx;
  text-align: center;
}

.time-line {
  width: 2rpx;
  flex: 1;
  background: #e8d0d0;
  margin: 8rpx 0;
  min-height: 48rpx;
}

.content-col {
  flex: 1;
  padding-bottom: 32rpx;
}

.content-card {
  background: #fdf5f6;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}

.content-header {
  margin-bottom: 8rpx;
}

.content-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.content-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
}

/* ========== 第六屏：来宾回执 ========== */
.rsvp-section {
  background: #fdf5f6;
}

.rsvp-intro {
  font-size: 28rpx;
  color: #888;
  text-align: center;
  margin-bottom: 40rpx;
}

.rsvp-form {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
font-size: 28rpx;
color: #555;
font-weight: 500;
display: block;
margin-bottom: 12rpx;
}

.form-hint {
font-size: 24rpx;
color: #b0a0a0;
font-weight: 400;
}

.required {
  color: #e8a0a0;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f9f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  background: #f9f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  min-height: 120rpx;
  box-sizing: border-box;
}

.radio-label {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-right: 48rpx;
  padding: 12rpx 24rpx;
  background: #f9f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #555;
  transition: all 0.3s;
}

.radio-label.checked {
  background: #fce8e8;
  color: #d97a7a;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  background: #f9f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  color: #ccc;
  font-size: 32rpx;
}

/* 协议勾选 */
.agreement-check {
  display: flex;
  align-items: center;
  margin: 24rpx 0 8rpx;
}

.agreement-checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #d97a7a;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
  background: #fff;
  transition: background 0.2s, border-color 0.2s;
}

.agreement-checkbox.checked {
  background: #e8a0a0;
  border-color: #e8a0a0;
}

.agreement-check-mark {
  font-size: 22rpx;
  color: #fff;
  line-height: 1;
}

.agreement-text {
  font-size: 24rpx;
  color: #999;
  line-height: 32rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.agreement-link {
  color: #d97a7a;
}

.rsvp-submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.rsvp-submit-btn::after {
  border: none;
}

.rsvp-submit-btn[disabled] {
  opacity: 0.6;
}

/* 回执成功 */
.rsvp-success {
  background: #fff;
  border-radius: 20rpx;
  padding: 64rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.success-check {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
}

.check-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #4caf50;
  opacity: 0.15;
}

.check-mark {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 64rpx;
  color: #4caf50;
  font-weight: 700;
}

.success-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #888;
}

/* ========== 第七屏：祝福墙 ========== */
.blessings-section {
  background: #fff;
}

.blessing-stats {
  padding: 20rpx 0;
  text-align: center;
}

.blessing-count {
  display: inline-block;
  font-size: 26rpx;
  color: #e8a0a0;
  background: #fdf5f6;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.blessing-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #aaa;
}

.blessing-input-bar {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
  align-items: center;
}

/* 头像选择按钮：彻底覆盖微信 button 默认样式 */
.blessing-avatar-btn {
  flex-shrink: 0;
  width: 64rpx !important;
  height: 64rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  background: transparent !important;
  line-height: 1 !important;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  border-radius: 50%;
  position: relative;
  box-sizing: border-box;
}

.blessing-avatar-btn::after {
  content: none !important;
  border: none !important;
}

.blessing-avatar-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid #e8a0a0;
  display: block;
}

.blessing-avatar-placeholder {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f9f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e8a0a0;
}

.blessing-avatar-icon {
  font-size: 32rpx;
  line-height: 1;
}

/* 当前随机语录预览：模拟 input 输入框样式 */
.blessing-preview {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  background: #fff;
  border: 2rpx solid #e8d0d0;
  border-radius: 32rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
}

.blessing-preview-text {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
}

/* 换一条按钮：粉色渐变圆形 + 白色刷新箭头 */
.blessing-refresh-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.refresh-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f8bbd0, #f48fb1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(244, 143, 177, 0.3);
}

/* 白色刷新箭头：圆环 + 箭头 */
.refresh-arrow {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  border-bottom-color: transparent;
  border-left-color: transparent;
  transform: rotate(-45deg);
  position: relative;
}

/* 箭头尖 */
.refresh-arrow::after {
  content: '';
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid #fff;
  border-top: 5rpx solid transparent;
  border-bottom: 5rpx solid transparent;
  transform: rotate(45deg);
}

.blessing-send-btn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 32rpx;
  background: #e0e0e0;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  transition: background 0.3s;
  white-space: nowrap;
}

.blessing-send-btn.active {
  background: #c98d8d;
}

/* 发送成功后的感谢文案 */
.blessing-input-bar.sent {
  justify-content: center;
  background: #fff8f8;
  border-radius: 32rpx;
  padding: 16rpx 0;
  border: 1rpx solid #f0e0e0;
}

.blessing-sent-text {
  font-size: 28rpx;
  color: #c98d8d;
  text-align: center;
}

.blessing-list {
  margin-top: 24rpx;
}

.blessing-list-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0e0e0;
}

.blessing-list-item:last-child {
  border-bottom: none;
}

.blessing-list-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.blessing-list-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e8a0a0, #d48888);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.blessing-list-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

/* 分页控件 */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 16rpx 0;
}

.page-btn {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #c98d8d;
  background: #fff;
  border-radius: 28rpx;
  border: 2rpx solid #f0e0e0;
}

.page-btn.disabled {
  color: #ccc;
  border-color: #eee;
}

.page-numbers {
  display: flex;
  gap: 12rpx;
}

.page-num {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
  background: #fff;
  border-radius: 50%;
  border: 2rpx solid #f0e0e0;
}

.page-num.active {
  color: #fff;
  background: #c98d8d;
  border-color: #c98d8d;
}

/* ========== 底部 ========== */
.footer-section {
  background: #fdf5f6;
  padding: 64rpx 32rpx 120rpx;
  text-align: center;
}

.footer-deco {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.footer-line {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #d4af37, transparent);
}

.footer-heart {
  font-size: 32rpx;
  color: #e8a0a0;
}

.footer-couple {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #8a6d4f;
  margin-bottom: 8rpx;
}

.footer-date {
  display: block;
  font-size: 26rpx;
  color: #b09080;
  margin-bottom: 48rpx;
}

.footer-actions {
  margin-bottom: 40rpx;
  display: flex;
  justify-content: center;
}

.share-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #e8a0a0, #d97a7a);
  color: #fff !important;
  font-size: 30rpx;
  padding: 24rpx 64rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(232, 160, 160, 0.35);
  line-height: 1.5;
}

.share-btn::after {
  border: none;
}

/* CSS 转发图标：圆弧 + 箭头 */
.share-icon-svg {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.share-icon-svg::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 2rpx;
  width: 24rpx;
  height: 20rpx;
  border: 4rpx solid #fff;
  border-radius: 50% 50% 0 0;
  border-bottom: none;
}

.share-arrow {
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 22rpx;
  background: #fff;
}

.share-arrow::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 12rpx;
  height: 12rpx;
  border-top: 4rpx solid #fff;
  border-right: 4rpx solid #fff;
}

.create-cta {
  font-size: 28rpx;
  color: #b09080;
  text-decoration: underline;
  padding: 16rpx;
}

/* 版权与版本信息 */
.footer-copyright {
  margin-top: 48rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(176, 144, 128, 0.15);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.copyright-text {
  font-size: 22rpx;
  color: #c4a99a;
  line-height: 1.5;
}

/* ========== 加载状态 ========== */
.loading-state {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fdf5f6;
  color: #aaa;
  font-size: 28rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #f0e0e0;
  border-top-color: #e8a0a0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ===== 用户信息补全弹窗 ===== */
.user-modal-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-modal {
  width: 80%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4a4a4a;
  margin-bottom: 12rpx;
}

.modal-sub {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 40rpx;
}

.modal-avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  padding: 0;
  margin: 0 auto 32rpx;
  background: #fdf5f6;
  border: 2rpx solid #f0dcdc;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
}

.modal-avatar-btn::after {
  border: none;
}

.modal-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.modal-avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-avatar-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.modal-avatar-text {
  font-size: 22rpx;
  color: #c07070;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-btn.secondary {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #e8a0a0, #d45d5d);
  color: #fff;
}
