.compress-page {
  min-height: 100vh;
  background: #fafafa;
  padding: 40rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}

.progress {
  margin-bottom: 30rpx;
}

.progress-bar {
  height: 16rpx;
  background: #eee;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #c98d8d;
  border-radius: 8rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
  text-align: right;
}

.log-panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  max-height: 70vh;
  overflow-y: auto;
  font-family: monospace;
}

.log-line {
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
  word-break: break-all;
}

.footer {
  margin-top: 40rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  background: #c98d8d;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
