/* pages/common/agreement/agreement.wxss */
.agreement-page {
  min-height: 100vh;
  background: #fff;
  padding: 40rpx 48rpx 80rpx;
  box-sizing: border-box;
}

.agreement-content {
  max-width: 100%;
}

.ag-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #c94f6d;
  margin-bottom: 16rpx;
}

.ag-updated {
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 48rpx;
}

.ag-section {
  margin-bottom: 44rpx;
}

.ag-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.ag-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 8rpx;
  text-align: justify;
}
