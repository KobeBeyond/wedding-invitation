/* pages/home/home.wxss */

.cover {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 渐变背景 */
.bg-gradient {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(160deg, #fff0f0 0%, #fde2e2 30%, #f8d0d0 60%, #f0c0c0 100%);
  z-index: 0;
}

/* 花瓣 */
.petals {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}

.petal {
  position: absolute;
  top: -60rpx;
  animation: petalFall linear infinite;
}

.petal-icon {
  font-size: 36rpx;
  opacity: 0.7;
}

@keyframes petalFall {
  0% {
    top: -60rpx;
    transform: rotate(0deg);
    opacity: 0;
  }
  10% { opacity: 0.8; }
  90% { opacity: 0.8; }
  100% {
    top: 100vh;
    transform: rotate(360deg);
    opacity: 0;
  }
}

/* 音乐按钮 */
.music-btn {
  position: fixed;
  top: 100rpx;
  right: 30rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  backdrop-filter: blur(10px);
  border: 2rpx solid rgba(232,160,160,0.3);
}

.music-icon {
  font-size: 32rpx;
}

.music-btn.playing .music-icon {
  animation: musicSpin 2s linear infinite;
}

@keyframes musicSpin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.music-wave {
  position: absolute;
  right: -16rpx;
  display: flex;
  gap: 4rpx;
}

.wave-bar {
  width: 4rpx;
  height: 16rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
  animation: waveAnim 0.6s ease-in-out infinite alternate;
}

.wave-bar:nth-child(2) { animation-delay: 0.2s; }
.wave-bar:nth-child(3) { animation-delay: 0.4s; }

@keyframes waveAnim {
  from { height: 8rpx; }
  to   { height: 24rpx; }
}

/* 主内容 */
.cover-content {
  position: relative;
  z-index: 2;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  padding-top: 120rpx;
}

/* 顶部标题 */
.cover-header {
  margin-bottom: 40rpx;
}

.header-text {
  font-size: 36rpx;
  color: var(--color-primary);
  letter-spacing: 12rpx;
  font-weight: 500;
}

/* 新人名字 */
.couple-names {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.name {
  font-size: 88rpx;
  font-weight: bold;
  color: var(--color-secondary);
  text-shadow: 0 4rpx 12rpx rgba(212,175,55,0.2);
}

.heart {
  font-size: 48rpx;
  color: var(--color-accent);
  animation: heartbeat 1.5s ease-in-out infinite;
}

@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.2); }
}

/* 分割线 */
.name-divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  width: 60%;
}

.name-divider .line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
}

.name-divider .diamond {
  color: var(--color-secondary);
  font-size: 20rpx;
}

/* 婚礼日期 */
.wedding-date {
  margin-bottom: 50rpx;
}

.wedding-date text {
  font-size: 34rpx;
  color: var(--color-text);
  letter-spacing: 4rpx;
}

/* 倒计时 */
.countdown {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 60rpx;
}

.cd-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.7);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  min-width: 88rpx;
  box-shadow: 0 4rpx 16rpx rgba(232,160,160,0.15);
}

.cd-num {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--color-accent);
  line-height: 1.2;
}

.cd-label {
  font-size: 20rpx;
  color: var(--color-muted);
}

.cd-sep {
  font-size: 36rpx;
  color: var(--color-primary);
  margin-top: -10rpx;
}

/* 婚礼当天 */
.wedding-day {
  margin-bottom: 60rpx;
}

.today-text {
  font-size: 36rpx;
  color: var(--color-accent);
  font-weight: bold;
}

/* 开启按钮 */
.open-btn-wrap {
  margin-bottom: 40rpx;
}

.open-btn {
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  font-size: 36rpx;
  padding: 28rpx 100rpx;
  animation: pulse 2s ease-in-out infinite;
}

/* 底部导航 */
.nav-bar {
  position: relative;
  z-index: 3;
  display: flex;
  justify-content: space-around;
  width: 100%;
  padding: 24rpx 20rpx env-safe-area-inset-bottom;
  background: rgba(255,255,255,0.5);
  backdrop-filter: blur(20px);
  border-top: 2rpx solid rgba(232,160,160,0.15);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.nav-icon {
  font-size: 36rpx;
}

.nav-text {
  font-size: 20rpx;
  color: var(--color-text);
}
