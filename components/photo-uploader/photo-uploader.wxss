/* components/photo-uploader/photo-uploader.wxss */
.photo-uploader {
  position: relative;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-actions {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: rgba(0, 0, 0, 0.5);
  height: 50rpx;
}

.photo-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  border-right: 1rpx solid rgba(255, 255, 255, 0.2);
}

.photo-btn:last-child {
  border-right: none;
}

.photo-btn.delete {
  background: rgba(255, 80, 80, 0.7);
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.add-icon {
  font-size: 56rpx;
  color: #ccc;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.upload-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.upload-progress {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 60rpx;
  width: 400rpx;
  text-align: center;
}

.progress-bar {
  height: 12rpx;
  background: #e8a0a0;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 28rpx;
  color: #666;
}
