/* components/danmaku/danmaku.wxss */

.danmaku-container {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.danmaku-item {
  position: absolute;
  right: -100%;
  white-space: nowrap;
  font-weight: 500;
  color: #8a4a4a;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 32rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  animation-name: danmuMove;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
  pointer-events: none;
  opacity: 0;
}

@keyframes danmuMove {
  0% {
    right: -100%;
    opacity: 0;
  }
  5%  { opacity: 1; }
  95% { opacity: 1; }
  100% {
    right: 100%;
    opacity: 0;
  }
}
