/* components/danmaku/danmaku.wxss */

.danmaku-container {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.danmaku-item {
  position: absolute;
  right: -100%;
  display: flex;
  align-items: center;
  white-space: nowrap;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 32rpx;
  padding: 6rpx 20rpx 6rpx 6rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  animation-name: danmuMove;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
  pointer-events: none;
  opacity: 0;
  /* 弹幕整体最大宽度：头像 + 文本区域 */
  max-width: 92vw;
  box-sizing: border-box;
}

.danmaku-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.danmaku-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e8a0a0, #d48888);
  color: #fff;
  font-size: 22rpx;
}

/* 文本容器：可收缩，让省略号生效 */
.danmaku-text-wrap {
  min-width: 0;
  max-width: 960rpx;
  overflow: hidden;
  display: block;
}

/* 超长文本省略号：text 需要 display:block + overflow hidden 才能触发 ellipsis */
.danmaku-text {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #8a4a4a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

@keyframes danmuMove {
  0% {
    right: -100%;
    opacity: 0;
  }
  5%  { opacity: 1; }
  95% { opacity: 1; }
  100% {
    right: 100%;
    opacity: 0;
  }
}
