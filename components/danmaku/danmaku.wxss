/* components/danmaku/danmaku.wxss */

.danmaku-container {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.danmaku-item {
  position: absolute;
  right: -100%;
  display: flex;
  align-items: center;
  white-space: nowrap;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 32rpx;
  padding: 6rpx 20rpx 6rpx 6rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  animation-name: danmuMove;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
  pointer-events: none;
  opacity: 0;
}

.danmaku-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.danmaku-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e8a0a0, #d48888);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.danmaku-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #8a4a4a;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

@keyframes danmuMove {
  0% {
    right: -100%;
    opacity: 0;
  }
  5%  { opacity: 1; }
  95% { opacity: 1; }
  100% {
    right: 100%;
    opacity: 0;
  }
}
